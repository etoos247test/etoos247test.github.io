rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myUserDocument() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return signedIn()
        && myUserDocument().data.active == true;
    }

    function administrator() {
      return activeUser()
        && myUserDocument().data.role in ['admin', 'staff'];
    }

    // 첫 Google 로그인 시 본인이 승인 요청을 한 번만 만들 수 있습니다.
    match /accessRequests/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending';

      allow read: if signedIn()
        && (request.auth.uid == uid || administrator());

      allow update, delete: if administrator();
    }

    // 사용자 승인 문서: users/{Firebase UID}
    match /users/{uid} {
      allow read: if signedIn()
        && (request.auth.uid == uid || administrator());

      allow create, update, delete: if administrator();
    }

    // 공개 공지 예시
    match /public/{document=**} {
      allow read: if true;
      allow write: if administrator();
    }

    // 학생 개인 자료 예시
    match /studentData/{uid}/{document=**} {
      allow read, write: if activeUser()
        && (request.auth.uid == uid || administrator());
    }

    // 명시하지 않은 모든 경로는 기본 차단합니다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
