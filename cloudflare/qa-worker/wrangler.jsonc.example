{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "etoos247-qa-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "FIREBASE_PROJECT_ID": "etoos247test-10ffa",
    "ALLOWED_ORIGIN": "https://etoos247test.github.io",
    "MAX_IMAGE_BYTES": "1048576",
    "MAX_IMAGES_PER_MESSAGE": "3"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "etoos247-qa",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "etoos247-qa-attachments"
    }
  ]
}
