rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function userExists() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function userData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isActive() {
      return userExists() && userData().active == true;
    }

    function validCampus(campus) {
      return campus == 'all' || campus == 'suseong1' || campus == 'suseong2';
    }

    function isMaster() {
      return isActive() && userData().role == 'master';
    }

    function teacherHasCampus(campus) {
      return isActive()
        && userData().role == 'teacher'
        && userData().allowedCampuses is list
        && campus in userData().allowedCampuses;
    }

    function canWriteCampus(campus) {
      return isMaster()
        || (campus != 'all' && teacherHasCampus(campus));
    }

    function validNoticeImage() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 1048576
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function noticeExists(noticeId) {
      return firestore.exists(/databases/(default)/documents/academyNotices/$(noticeId));
    }

    function noticeData(noticeId) {
      return firestore.get(/databases/(default)/documents/academyNotices/$(noticeId)).data;
    }

    function canReadNoticeImage(campus, noticeId) {
      return isActive()
        && noticeExists(noticeId)
        && noticeData(noticeId).campus == campus
        && (
          isMaster()
          || (
            userData().role == 'teacher'
            && (campus == 'all' || teacherHasCampus(campus))
          )
          || (
            userData().role == 'student'
            && noticeData(noticeId).visible == true
            && (campus == 'all' || userData().campus == campus)
          )
        );
    }

    /* 기존 1장 공지 사진과의 호환 경로 */
    match /academy-notices/v1/{campus}/{noticeId}/{fileName} {
      allow read: if validCampus(campus) && canReadNoticeImage(campus, noticeId);
      allow create, update: if validCampus(campus)
        && canWriteCampus(campus)
        && validNoticeImage();
      allow delete: if validCampus(campus) && canWriteCampus(campus);
    }

    /* 새 공지 사진은 한 묶음에 slot-1, slot-2, slot-3만 허용 */
    match /academy-notices/v2/{campus}/{noticeId}/{batchId}/{slot} {
      allow read: if validCampus(campus) && canReadNoticeImage(campus, noticeId);
      allow create, update: if validCampus(campus)
        && canWriteCampus(campus)
        && slot.matches('^slot-[1-3]$')
        && validNoticeImage();
      allow delete: if validCampus(campus)
        && canWriteCampus(campus)
        && slot.matches('^slot-[1-3]$');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
