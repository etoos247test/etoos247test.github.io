rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return signedIn() && currentUserData().active == true;
    }

    function isMaster() {
      return isActiveUser() && currentUserData().role == "master";
    }

    function isTeacher() {
      return isActiveUser() && currentUserData().role == "teacher";
    }

    function isStudent() {
      return isActiveUser() && currentUserData().role == "student";
    }

    function hasCampusAccess(campus) {
      return isMaster()
        || (
          isTeacher()
          && currentUserData().allowedCampuses is list
          && campus in currentUserData().allowedCampuses
        );
    }

    function canAnswerQuestions() {
      return isMaster()
        || (
          isTeacher()
          && currentUserData().canAnswerQuestions == true
        );
    }

    function canApproveStudents() {
      return isMaster()
        || (
          isTeacher()
          && currentUserData().canApproveStudents == true
        );
    }

    function canManageStudentInfo() {
      return isMaster()
        || (
          isTeacher()
          && currentUserData().canManageStudentInfo == true
        );
    }

    function canResetStudentPassword() {
      return isMaster()
        || (
          isTeacher()
          && currentUserData().canResetStudentPassword == true
        );
    }

    match /users/{userId} {
      allow get: if signedIn()
        && (
          request.auth.uid == userId
          || isMaster()
          || (
            isTeacher()
            && resource.data.role == "student"
            && hasCampusAccess(resource.data.campus)
            && (
              resource.data.active == true
              || canApproveStudents()
            )
          )
        );

      allow list: if isMaster()
        || (
          isTeacher()
          && resource.data.role == "student"
          && hasCampusAccess(resource.data.campus)
          && (
            resource.data.active == true
            || canApproveStudents()
          )
        );

      allow create, delete: if isMaster();

      allow update: if isMaster()
        || (
          isTeacher()
          && resource.data.role == "student"
          && request.resource.data.role == "student"
          && hasCampusAccess(resource.data.campus)
          && request.resource.data.campus == resource.data.campus
          && (
            (
              canManageStudentInfo()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "studentId",
                "name",
                "updatedAt",
                "updatedBy"
              ])
            )
            ||
            (
              canApproveStudents()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "active",
                "approvedAt",
                "approvedBy",
                "updatedAt",
                "updatedBy"
              ])
            )
          )
        );
    }

    match /teacherRequests/{requestId} {
      allow read: if signedIn()
        && (
          request.auth.uid == requestId
          || isMaster()
        );

      allow create: if signedIn()
        && request.auth.uid == requestId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == "pending"
        && request.resource.data.requestedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          "uid",
          "name",
          "email",
          "status",
          "requestedAt",
          "updatedAt"
        ]);

      allow update: if (
          signedIn()
          && request.auth.uid == requestId
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.status == "pending"
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "name",
            "email",
            "status",
            "requestedAt",
            "updatedAt"
          ])
        )
        || isMaster();

      allow delete: if isMaster();
    }

    match /questions/{questionId} {
      allow read: if (
          isStudent()
          && resource.data.studentUid == request.auth.uid
        )
        || isMaster()
        || (
          isTeacher()
          && canAnswerQuestions()
          && hasCampusAccess(resource.data.campus)
        );

      allow create: if isStudent()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.campus == currentUserData().campus
        && request.resource.data.status == "waiting"
        && request.resource.data.answer == ""
        && request.resource.data.keys().hasOnly([
          "studentUid",
          "studentId",
          "studentName",
          "campus",
          "subject",
          "questionText",
          "status",
          "answer",
          "createdAt",
          "updatedAt"
        ]);

      allow update: if (
          isMaster()
          || (
            isTeacher()
            && canAnswerQuestions()
            && hasCampusAccess(resource.data.campus)
          )
        )
        && request.resource.data.studentUid == resource.data.studentUid
        && request.resource.data.campus == resource.data.campus
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "answer",
          "status",
          "answeredAt",
          "answeredBy",
          "updatedAt"
        ]);

      allow delete: if isMaster();
    }

    match /auditLogs/{logId} {
      allow read: if isMaster();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
