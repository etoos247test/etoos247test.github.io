rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function currentUserData() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isActiveUser() {
      return signedIn()
        && currentUserData().active == true;
    }

    function isMaster() {
      return isActiveUser()
        && currentUserData().role == "master";
    }

    function isTeacher() {
      return isActiveUser()
        && (
          currentUserData().role == "teacher"
          || currentUserData().role == "master"
        );
    }

    function isStudent() {
      return isActiveUser()
        && currentUserData().role == "student";
    }

    match /users/{userId} {
      allow read: if signedIn()
        && (
          request.auth.uid == userId
          || isMaster()
        );

      allow create, update, delete: if isMaster();
    }

    match /teacherRequests/{requestId} {
      // 요청자는 자기 요청만 보고, 마스터는 전체 요청을 봅니다.
      allow read: if signedIn()
        && (
          request.auth.uid == requestId
          || isMaster()
        );

      // Google 로그인 사용자는 자기 UID로만 최초 등록 요청을 만들 수 있습니다.
      allow create: if signedIn()
        && request.auth.uid == requestId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == "pending"
        && request.resource.data.requestedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          "uid",
          "name",
          "email",
          "status",
          "requestedAt",
          "updatedAt"
        ]);

      // 요청자는 승인 전 자기 요청 내용만 다시 저장할 수 있습니다.
      // 승인·반려 처리는 마스터만 할 수 있습니다.
      allow update: if (
          signedIn()
          && request.auth.uid == requestId
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.status == "pending"
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "name",
              "email",
              "status",
              "requestedAt",
              "updatedAt"
            ])
        )
        || isMaster();

      allow delete: if isMaster();
    }

    match /questions/{questionId} {
      allow read: if (
          isStudent()
          && resource.data.studentUid == request.auth.uid
        )
        || isTeacher();

      allow create: if isStudent()
        && request.resource.data.studentUid == request.auth.uid;

      allow update: if isTeacher();
      allow delete: if isMaster();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
