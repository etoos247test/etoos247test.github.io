rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userProfileExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function validCampus(campus) {
      return campus == "suseong1" || campus == "suseong2";
    }

    function validBoardCampus(campus) {
      return campus == "all" || validCampus(campus);
    }

    function validStudentCode(studentId) {
      return studentId is string
        && studentId.matches('^[MS](00[1-9]|0[1-9][0-9]|1[0-9]{2})$');
    }

    function codeMatchesCampus(studentId, campus) {
      return validStudentCode(studentId)
        && (
          (campus == "suseong1" && studentId.matches('^M.*'))
          || (campus == "suseong2" && studentId.matches('^S.*'))
        );
    }

    function isActiveUser() {
      return userProfileExists() && currentUserData().active == true;
    }

    function isMaster() {
      return isActiveUser() && currentUserData().role == "master";
    }

    function isTeacher() {
      return isActiveUser() && currentUserData().role == "teacher";
    }

    function isStudent() {
      return isActiveUser() && currentUserData().role == "student";
    }

    function hasCampusAccess(campus) {
      return isMaster()
        || (
          isTeacher()
          && currentUserData().allowedCampuses is list
          && campus in currentUserData().allowedCampuses
        );
    }

    function canManageBoardCampus(campus) {
      return isMaster()
        || (
          isTeacher()
          && campus != "all"
          && hasCampusAccess(campus)
        );
    }

    function canManageNotices() {
      return isMaster()
        || (isTeacher() && currentUserData().get("canManageNotices", true) == true);
    }

    function canManageSchedules() {
      return isMaster()
        || (isTeacher() && currentUserData().get("canManageSchedules", true) == true);
    }

    function canManageScores() {
      return isMaster()
        || (isTeacher() && currentUserData().get("canManageScores", true) == true);
    }

    function canManageCounseling() {
      return isMaster()
        || (isTeacher() && currentUserData().get("canManageCounseling", true) == true);
    }

    function canAnswerQuestions() {
      return isMaster()
        || (isTeacher() && currentUserData().get("canAnswerQuestions", true) == true);
    }

    function canApproveStudents() {
      return isMaster()
        || (isTeacher() && currentUserData().canApproveStudents == true);
    }

    function canManageStudentInfo() {
      return isMaster()
        || (isTeacher() && currentUserData().canManageStudentInfo == true);
    }

    function canReviewCampus(campus) {
      return canApproveStudents() && hasCampusAccess(campus);
    }

    match /users/{userId} {
      allow get: if signedIn()
        && (
          request.auth.uid == userId
          || isMaster()
          || (
            isTeacher()
            && resource.data.role == "student"
            && hasCampusAccess(resource.data.campus)
            && (resource.data.active == true || canApproveStudents())
          )
        );

      allow list: if isMaster()
        || (
          isTeacher()
          && resource.data.role == "student"
          && hasCampusAccess(resource.data.campus)
          && (resource.data.active == true || canApproveStudents())
        );

      allow create: if canReviewCampus(request.resource.data.campus)
        && request.resource.data.role == "student"
        && request.resource.data.active == true
        && validCampus(request.resource.data.campus)
        && codeMatchesCampus(request.resource.data.studentId, request.resource.data.campus)
        && request.resource.data.email is string
        && request.resource.data.authProvider == "google.com"
        && request.resource.data.approvedBy == request.auth.uid
        && request.resource.data.approvedAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "role",
          "active",
          "campus",
          "studentId",
          "name",
          "email",
          "authProvider",
          "approvedAt",
          "approvedBy",
          "createdAt",
          "updatedAt",
          "updatedBy"
        ])
        && getAfter(/databases/$(database)/documents/studentApplications/$(userId)).data.status == "approved"
        && getAfter(/databases/$(database)/documents/studentApplications/$(userId)).data.assignedStudentId == request.resource.data.studentId
        && getAfter(/databases/$(database)/documents/studentCodes/$(request.resource.data.studentId)).data.uid == userId;

      allow update: if isMaster()
        || (
          isTeacher()
          && resource.data.role == "student"
          && request.resource.data.role == "student"
          && validCampus(resource.data.campus)
          && hasCampusAccess(resource.data.campus)
          && (
            (
              canManageStudentInfo()
              && request.resource.data.campus == resource.data.campus
              && codeMatchesCampus(request.resource.data.studentId, resource.data.campus)
              && request.resource.data.updatedBy == request.auth.uid
              && request.resource.data.updatedAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "studentId",
                "name",
                "updatedAt",
                "updatedBy"
              ])
            )
            ||
            (
              canApproveStudents()
              && request.resource.data.campus == resource.data.campus
              && request.resource.data.updatedBy == request.auth.uid
              && request.resource.data.updatedAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "active",
                "approvedAt",
                "approvedBy",
                "updatedAt",
                "updatedBy"
              ])
            )
          )
        );

      allow delete: if isMaster();
    }

    match /studentApplications/{studentUid} {
      allow get: if signedIn()
        && (
          request.auth.uid == studentUid
          || isMaster()
          || (canApproveStudents() && hasCampusAccess(resource.data.campus))
        );

      allow list: if isMaster()
        || (canApproveStudents() && hasCampusAccess(resource.data.campus));

      allow create: if signedIn()
        && request.auth.uid == studentUid
        && validCampus(request.resource.data.campus)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == "pending"
        && request.resource.data.requestedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          "uid",
          "name",
          "email",
          "campus",
          "contactLast4",
          "status",
          "requestedAt",
          "updatedAt"
        ]);

      allow update: if (
          signedIn()
          && request.auth.uid == studentUid
          && resource.data.status != "approved"
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email
          && validCampus(request.resource.data.campus)
          && request.resource.data.status == "pending"
          && request.resource.data.requestedAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.keys().hasOnly([
            "uid",
            "name",
            "email",
            "campus",
            "contactLast4",
            "status",
            "requestedAt",
            "updatedAt"
          ])
        )
        || (
          canReviewCampus(resource.data.campus)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.campus == resource.data.campus
          && request.resource.data.updatedAt == request.time
          && (
            (
              request.resource.data.status == "approved"
              && codeMatchesCampus(request.resource.data.assignedStudentId, resource.data.campus)
              && request.resource.data.reviewedBy == request.auth.uid
              && request.resource.data.reviewedAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "status",
                "assignedStudentId",
                "approvedName",
                "reviewedAt",
                "reviewedBy",
                "updatedAt"
              ])
              && getAfter(/databases/$(database)/documents/users/$(studentUid)).data.role == "student"
              && getAfter(/databases/$(database)/documents/users/$(studentUid)).data.studentId == request.resource.data.assignedStudentId
              && getAfter(/databases/$(database)/documents/studentCodes/$(request.resource.data.assignedStudentId)).data.uid == studentUid
            )
            ||
            (
              request.resource.data.status == "rejected"
              && request.resource.data.reviewedBy == request.auth.uid
              && request.resource.data.reviewedAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "status",
                "reviewedAt",
                "reviewedBy",
                "updatedAt"
              ])
            )
          )
        );

      allow delete: if isMaster();
    }

    match /studentCodes/{studentId} {
      allow get, list: if isMaster()
        || (
          isTeacher()
          && (
            canApproveStudents()
            || canManageStudentInfo()
            || canManageScores()
            || canManageCounseling()
          )
        );

      allow create, update: if validStudentCode(studentId)
        && request.resource.data.studentId == studentId
        && codeMatchesCampus(studentId, request.resource.data.campus)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "uid",
          "campus",
          "studentId",
          "name",
          "updatedAt",
          "updatedBy"
        ])
        && (
          canReviewCampus(request.resource.data.campus)
          || (canManageStudentInfo() && hasCampusAccess(request.resource.data.campus))
        )
        && getAfter(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.studentId == studentId
        && getAfter(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.campus == request.resource.data.campus;

      allow delete: if isMaster()
        || (
          canManageStudentInfo()
          && hasCampusAccess(resource.data.campus)
          && resource.data.studentId == studentId
        );
    }

    match /teacherRequests/{requestId} {
      allow read: if signedIn()
        && (request.auth.uid == requestId || isMaster());

      allow create: if signedIn()
        && request.auth.uid == requestId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == "pending"
        && request.resource.data.requestedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          "uid",
          "name",
          "email",
          "status",
          "requestedAt",
          "updatedAt"
        ]);

      allow update: if (
          signedIn()
          && request.auth.uid == requestId
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.status == "pending"
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "name",
            "email",
            "status",
            "requestedAt",
            "updatedAt"
          ])
        )
        || isMaster();

      allow delete: if isMaster();
    }

    match /questions/{questionId} {
      allow read: if (
          isStudent()
          && resource.data.studentUid == request.auth.uid
        )
        || isMaster()
        || (
          isTeacher()
          && canAnswerQuestions()
          && hasCampusAccess(resource.data.campus)
        );

      allow create: if isStudent()
        && validCampus(currentUserData().campus)
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.studentId == currentUserData().studentId
        && request.resource.data.studentName == currentUserData().name
        && request.resource.data.campus == currentUserData().campus
        && request.resource.data.status == "waiting"
        && request.resource.data.answer == ""
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          "studentUid",
          "studentId",
          "studentName",
          "campus",
          "subject",
          "questionText",
          "status",
          "answer",
          "createdAt",
          "updatedAt"
        ]);

      allow update: if isMaster()
        || (
          isTeacher()
          && canAnswerQuestions()
          && hasCampusAccess(resource.data.campus)
          && request.resource.data.studentUid == resource.data.studentUid
          && request.resource.data.campus == resource.data.campus
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "answer",
            "status",
            "answeredAt",
            "answeredBy",
            "updatedAt"
          ])
        )
        || (
          canManageStudentInfo()
          && hasCampusAccess(resource.data.campus)
          && (isMaster() || request.resource.data.campus == resource.data.campus)
          && request.resource.data.studentUid == resource.data.studentUid
          && request.resource.data.studentId == get(/databases/$(database)/documents/users/$(resource.data.studentUid)).data.studentId
          && request.resource.data.studentName == get(/databases/$(database)/documents/users/$(resource.data.studentUid)).data.name
          && request.resource.data.campus == get(/databases/$(database)/documents/users/$(resource.data.studentUid)).data.campus
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "studentId",
            "studentName",
            "campus",
            "updatedAt"
          ])
        );

      allow delete: if isMaster();
    }

    match /academyNotices/{noticeId} {
      allow read: if isActiveUser();

      allow create: if canManageNotices()
        && canManageBoardCampus(request.resource.data.campus)
        && validBoardCampus(request.resource.data.campus)
        && request.resource.data.title is string
        && request.resource.data.content is string
        && request.resource.data.pinned is bool
        && request.resource.data.visible is bool
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if canManageNotices()
        && canManageBoardCampus(resource.data.campus)
        && request.resource.data.campus == resource.data.campus
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if canManageNotices()
        && canManageBoardCampus(resource.data.campus);
    }

    match /examSchedules/{scheduleId} {
      allow read: if isActiveUser();

      allow create: if canManageSchedules()
        && canManageBoardCampus(request.resource.data.campus)
        && validBoardCampus(request.resource.data.campus)
        && request.resource.data.examDate is string
        && request.resource.data.periodLabel is string
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.visible is bool
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if canManageSchedules()
        && canManageBoardCampus(resource.data.campus)
        && request.resource.data.campus == resource.data.campus
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if canManageSchedules()
        && canManageBoardCampus(resource.data.campus);
    }

    match /studentScores/{scoreId} {
      allow read: if isMaster()
        || (isTeacher() && canManageScores() && hasCampusAccess(resource.data.campus))
        || (isStudent() && resource.data.studentUid == request.auth.uid);

      allow create: if (isMaster()
          || (isTeacher() && canManageScores() && hasCampusAccess(request.resource.data.campus)))
        && validCampus(request.resource.data.campus)
        && codeMatchesCampus(request.resource.data.studentId, request.resource.data.campus)
        && request.resource.data.studentUid is string
        && request.resource.data.schoolYear is int
        && request.resource.data.updatedBy == request.auth.uid;

      allow update: if (isMaster()
          || (isTeacher() && canManageScores() && hasCampusAccess(resource.data.campus)))
        && request.resource.data.campus == resource.data.campus
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.studentUid == resource.data.studentUid
        && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if isMaster()
        || (isTeacher() && canManageScores() && hasCampusAccess(resource.data.campus));
    }

    match /counselingRecords/{recordId} {
      allow read: if isMaster()
        || (isTeacher() && canManageCounseling() && hasCampusAccess(resource.data.campus));

      allow create: if (isMaster()
          || (isTeacher() && canManageCounseling() && hasCampusAccess(request.resource.data.campus)))
        && validCampus(request.resource.data.campus)
        && codeMatchesCampus(request.resource.data.studentId, request.resource.data.campus)
        && request.resource.data.studentUid is string
        && request.resource.data.counselingDate is string
        && request.resource.data.counselorUid == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;

      allow update: if (isMaster()
          || (isTeacher() && canManageCounseling() && hasCampusAccess(resource.data.campus)))
        && request.resource.data.campus == resource.data.campus
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.studentUid == resource.data.studentUid
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if isMaster()
        || (isTeacher() && canManageCounseling() && hasCampusAccess(resource.data.campus));
    }

    match /auditLogs/{logId} {
      allow read: if isMaster();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
