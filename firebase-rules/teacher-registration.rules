rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function currentUserData() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isActiveUser() {
      return signedIn()
        && currentUserData().active == true;
    }

    function isMaster() {
      return isActiveUser()
        && currentUserData().role == "master";
    }

    function isTeacher() {
      return isActiveUser()
        && (
          currentUserData().role == "teacher"
          || currentUserData().role == "master"
        );
    }

    function isStudent() {
      return isActiveUser()
        && currentUserData().role == "student";
    }

    match /users/{userId} {
      // 본인은 자기 사용자 문서를 읽을 수 있습니다.
      // 마스터는 모든 사용자 문서를 읽을 수 있습니다.
      // 교사는 승인된 학생(role: student, active: true) 정보만 읽을 수 있습니다.
      allow get: if signedIn()
        && (
          request.auth.uid == userId
          || isMaster()
          || (
            isTeacher()
            && resource.data.role == "student"
            && resource.data.active == true
          )
        );

      // 교사 화면의 학생 목록 쿼리는 반드시
      // where("role", "==", "student")와
      // where("active", "==", true)를 함께 사용해야 합니다.
      allow list: if isTeacher()
        && resource.data.role == "student"
        && resource.data.active == true;

      allow create, update, delete: if isMaster();
    }

    match /teacherRequests/{requestId} {
      allow read: if signedIn()
        && (
          request.auth.uid == requestId
          || isMaster()
        );

      allow create: if signedIn()
        && request.auth.uid == requestId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == "pending"
        && request.resource.data.requestedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          "uid",
          "name",
          "email",
          "status",
          "requestedAt",
          "updatedAt"
        ]);

      allow update: if (
          signedIn()
          && request.auth.uid == requestId
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.status == "pending"
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "name",
              "email",
              "status",
              "requestedAt",
              "updatedAt"
            ])
        )
        || isMaster();

      allow delete: if isMaster();
    }

    match /questions/{questionId} {
      // 학생은 자기 질문만 읽고, 교사·마스터는 모든 질문을 읽습니다.
      allow read: if (
          isStudent()
          && resource.data.studentUid == request.auth.uid
        )
        || isTeacher();

      // 학생은 자기 UID와 사용자 문서의 학생번호·이름으로만 질문을 등록합니다.
      allow create: if isStudent()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.studentId == currentUserData().studentId
        && request.resource.data.studentName == currentUserData().name
        && request.resource.data.status == "waiting"
        && request.resource.data.answer == "";

      allow update: if isTeacher();
      allow delete: if isMaster();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
