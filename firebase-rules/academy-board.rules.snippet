// Insert these match blocks inside service cloud.firestore > match /databases/{database}/documents
// and before the final match /{document=**} deny rule.

match /academyNotices/{noticeId} {
  allow read: if isActiveUser();

  allow create: if (
      isMaster()
      || (
        isTeacher()
        && request.resource.data.campus != "all"
        && hasCampusAccess(request.resource.data.campus)
      )
    )
    && request.resource.data.campus in ["all", "suseong1", "suseong2"]
    && request.resource.data.title is string
    && request.resource.data.content is string
    && request.resource.data.pinned is bool
    && request.resource.data.visible is bool
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.updatedBy == request.auth.uid
    && request.resource.data.createdAt == request.time
    && request.resource.data.updatedAt == request.time;

  allow update: if (
      isMaster()
      || (
        isTeacher()
        && resource.data.campus != "all"
        && hasCampusAccess(resource.data.campus)
        && request.resource.data.campus == resource.data.campus
      )
    )
    && request.resource.data.updatedBy == request.auth.uid
    && request.resource.data.updatedAt == request.time
    && request.resource.data.createdAt == resource.data.createdAt
    && request.resource.data.createdBy == resource.data.createdBy;

  allow delete: if isMaster()
    || (
      isTeacher()
      && resource.data.campus != "all"
      && hasCampusAccess(resource.data.campus)
    );
}

match /examSchedules/{scheduleId} {
  allow read: if isActiveUser();

  allow create: if (
      isMaster()
      || (
        isTeacher()
        && request.resource.data.campus != "all"
        && hasCampusAccess(request.resource.data.campus)
      )
    )
    && request.resource.data.campus in ["all", "suseong1", "suseong2"]
    && request.resource.data.examDate is string
    && request.resource.data.periodLabel is string
    && request.resource.data.title is string
    && request.resource.data.description is string
    && request.resource.data.visible is bool
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.updatedBy == request.auth.uid
    && request.resource.data.createdAt == request.time
    && request.resource.data.updatedAt == request.time;

  allow update: if (
      isMaster()
      || (
        isTeacher()
        && resource.data.campus != "all"
        && hasCampusAccess(resource.data.campus)
        && request.resource.data.campus == resource.data.campus
      )
    )
    && request.resource.data.updatedBy == request.auth.uid
    && request.resource.data.updatedAt == request.time
    && request.resource.data.createdAt == resource.data.createdAt
    && request.resource.data.createdBy == resource.data.createdBy;

  allow delete: if isMaster()
    || (
      isTeacher()
      && resource.data.campus != "all"
      && hasCampusAccess(resource.data.campus)
    );
}
